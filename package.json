{
  "name": "tower-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "android:run": "npm run android:sync && node scripts/android-apk.mjs --install"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
